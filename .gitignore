# FluSight Sandbox Visualization & Evaluation Suite
# Ignore local Parquet cache tables, compiled bytecode, and test scratch
.cache/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.DS_Store

# Surveillance data is rebuilt by rebuild_surveillance.py (setup.sh runs it). The 2010-2023
# ILINet / FluSurv-NET history it cannot recreate is tracked read-only in data/seed/.
data/surveillance/

# Per-user environment and settings (setup.sh creates .venv; copy config.example.json to config.json)
.venv/
config.json
config.toml
